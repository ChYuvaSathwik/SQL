Display the department name and employee count for departments whose average salary is greater than the average salary of all departments.

SELECT d.department_name, e.employee_count
FROM departments AS d
INNER JOIN (
    SELECT department_id,
           AVG(salary) AS avg_salary,
           COUNT(*) AS employee_count
    FROM employees
    GROUP BY department_id
) AS e
ON d.department_id = e.department_id
WHERE e.avg_salary > (
    SELECT AVG(x.avg_salary)
    FROM (
        SELECT department_id,
               AVG(salary) AS avg_salary
        FROM employees
        GROUP BY department_id
    ) AS x
);





















