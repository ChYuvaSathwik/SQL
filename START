2. Find all employees whose salary is greater than the average salary of all employees.
SELECT *
FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
);
3. Find the employee(s) who have the same salary as Arun.
SELECT *
FROM employees
WHERE salary = (
    SELECT salary
    FROM employees
    WHERE name = 'Arun'
);

