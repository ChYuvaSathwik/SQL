1. Display every employee along with the average salary of their department.
SELECT *,
       AVG(Salary) OVER (
           PARTITION BY Department
       ) AS average_salary
FROM Employee;
2. Display every employee along with the total salary paid in their department.
SELECT *,
       SUM(Salary) OVER (
           PARTITION BY Department
       ) AS total_salary_per_department
FROM Employee;
3. Display every employee along with the number of employees in their department.
SELECT *,
       COUNT(*) OVER (
           PARTITION BY Department
       ) AS employee_count
FROM Employee;
4. Display every employee along with the highest salary in their department.
SELECT *,
       MAX(Salary) OVER (
           PARTITION BY Department
       ) AS highest_department_salary
FROM Employee;
5. Display every employee along with the lowest salary in their department.
SELECT *,
       MIN(Salary) OVER (
           PARTITION BY Department
       ) AS lowest_department_salary
FROM Employee;
