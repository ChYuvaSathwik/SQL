1. Display the average salary of each department
SELECT *
FROM (
    SELECT Department,
           AVG(Salary) AS Average_Salary
    FROM Employee
    GROUP BY Department
) AS e;
2. Display departments whose average salary is greater than 45000
SELECT *
FROM (
    SELECT Department,
           AVG(Salary) AS Average_Salary
    FROM Employee
    GROUP BY Department
) AS e
WHERE e.Average_Salary > 45000;
3. Display only the department names whose average salary is greater than 45000
SELECT Department
FROM (
    SELECT Department,
           AVG(Salary) AS Average_Salary
    FROM Employee
    GROUP BY Department
) AS e
WHERE e.Average_Salary > 45000;
4. Display departments whose average salary is greater than 45000, sorted in descending order of average salary
SELECT *
FROM (
    SELECT Department,
           AVG(Salary) AS Average_Salary
    FROM Employee
    GROUP BY Department
) AS e
WHERE e.Average_Salary > 45000
ORDER BY e.Average_Salary DESC;
5. Display the highest average salary among all departments
SELECT MAX(e.avg_high_salary)
FROM (
    SELECT AVG(Salary) AS avg_high_salary
    FROM Employee
    GROUP BY Department
) AS e;

